          "name": "Name",
          "location": "Location (only when not using the Home Assistant location)",
          "msn_url": "MSN weather URL (optional)",
          "language": "Text language",
          "use_home_location": "Use the Home Assistant location"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to MSN weather.",
